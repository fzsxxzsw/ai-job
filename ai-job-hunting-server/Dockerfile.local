FROM maven:3.9.9-eclipse-temurin-17 AS build

WORKDIR /workspace
COPY pom.xml .
COPY src ./src
COPY application-local.properties ./src/main/resources/application.properties
RUN --mount=type=cache,target=/root/.m2 mvn --batch-mode --no-transfer-progress -DskipTests package

FROM eclipse-temurin:17-jre

WORKDIR /app
COPY --from=build /workspace/target/ai-job.jar /app/ai-job.jar

EXPOSE 9100 6768

ENTRYPOINT ["java", "-jar", "/app/ai-job.jar"]
