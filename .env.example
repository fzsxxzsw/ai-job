# Copy this file to .env and fill in the AI keys.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_PASSWORD=replace-with-another-long-random-password

# Required by the durable Python Agent API. Generate a new random token for
# each installation; never copy a token from documentation or commit .env.
AGENT_INTERNAL_TOKEN=
AGENT_SUBJECT_REF=local-installation

# Application outcome reports: enable only with the explicit outcome schema migration.
# One switch enables API 9100 and the Agent 9101 worker together.
API_OUTCOME_ENABLED=false
# Optional dedicated random secret (at least 32 characters). When empty, Compose
# reuses AGENT_INTERNAL_TOKEN on both sides. Never place either token in Chrome.
API_OUTCOME_INTERNAL_TOKEN=
API_OUTCOME_READ_WAIT_HOURS=24
API_OUTCOME_UNREAD_WAIT_HOURS=72
API_OUTCOME_LEASE_SECONDS=180
AGENT_OUTCOME_SCAN_SECONDS=5
AGENT_OUTCOME_JOB_TIMEOUT_SECONDS=300

# Unified reply/application/career graphs. Enable after their additive schema
# migration. The API automation switch also enables its Agent worker; both use
# the existing outcome URL and server-only token above. This does not start
# delivery or authorize sensitive resume/contact exchanges.
API_AUTOMATION_ENABLED=false
API_CAREER_ENABLED=false
AGENT_AUTOMATION_SCAN_SECONDS=5
AGENT_AUTOMATION_JOB_TIMEOUT_SECONDS=300

# Required for AI chat/filtering.
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_COMPLETIONS_PATH=/chat/completions
AI_MODEL=qwen3-vl-32b-thinking
AI_TIMEOUT_SECONDS=15
# The selected model is thinking-only. Bound its reasoning so chat stays inside the 15s request budget.
AI_THINKING_BUDGET=256

# Self-hosted personal use; does not change authentication or provider billing.
JOB_HELPER_PERSONAL_MODE=true
# Bind the existing local personal account; set its numeric database id.
API_OWNER_USER_ID=0
API_ALLOWED_MODEL_HOSTS=
API_CONFIRMED_EDUCATION=

# Optional SMTP notifications; disabled until real SMTP credentials are configured.
API_MAIL_ENABLED=false
API_MAIL_HOST=
API_MAIL_PORT=465
API_MAIL_USERNAME=
API_MAIL_PASSWORD=
API_MAIL_SENDER=
API_MAIL_SECURITY=ssl
API_MAIL_TIMEOUT_SECONDS=10

# Build/release scripts set version and build ID from the verified receipt.
# Do not pin JOB_HELPER_BUILD_ID or image tags in this file.
# The Python API remains bound to 127.0.0.1:9100 by docker-compose.local.yml.
