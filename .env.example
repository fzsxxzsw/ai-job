# Copy this file to .env and fill in the AI keys.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_PASSWORD=replace-with-another-long-random-password
SMART_PASSWORD=replace-with-a-third-long-random-password

# Required by the durable Python Agent API. Generate a new random token for
# each installation; never copy a token from documentation or commit .env.
AGENT_INTERNAL_TOKEN=
AGENT_SUBJECT_REF=local-installation

# Required for AI chat/filtering.
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_COMPLETIONS_PATH=/chat/completions
AI_MODEL=qwen3-vl-32b-thinking
AI_TIMEOUT_SECONDS=15
# The selected model is thinking-only. Bound its reasoning so chat stays inside the 15s request budget.
AI_THINKING_BUDGET=256

# Keep 127.0.0.1 for personal use. Set 0.0.0.0 only when LAN access is required
# and Windows Firewall has been restricted to trusted devices.
BACKEND_BIND_ADDRESS=127.0.0.1

# Required only for importing and parsing a PDF resume.
KIMI_API_KEY=
