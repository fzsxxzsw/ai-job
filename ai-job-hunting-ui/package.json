{
  "name": "ai-job-hunting",
  "private": true,
  "version": "0.0.62",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "prepare": "wxt prepare",
    "test": "pnpm run test:unit && pnpm run protobuf:check && pnpm run test:protobuf-csp",
    "test:unit": "node scripts/run-tests.mjs",
    "test:protobuf-csp": "node scripts/run-protobuf-csp-smoke.mjs",
    "protobuf:generate": "node scripts/generate-protobuf.mjs",
    "protobuf:check": "node scripts/generate-protobuf.mjs --check",
    "protobuf:update-golden": "node scripts/generate-protobuf.mjs --update-golden",
    "typecheck": "wxt prepare && vue-tsc --noEmit",
    "build": "pnpm test && pnpm run typecheck && pnpm run package:extension",
    "build:extension": "pnpm run build:extension:raw && pnpm run verify:extension",
    "build:extension:raw": "wxt build",
    "package:extension": "wxt zip && node scripts/verify-extension.mjs --require-zip",
    "build:local:bundle": "vue-tsc --noEmit && vite build --mode personal",
    "build:local": "pnpm run build",
    "verify:extension": "node scripts/verify-extension.mjs",
    "zip": "pnpm run package:extension"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "element-plus": "^2.6.3",
    "event-source-polyfill": "^1.0.31",
    "long": "5.2.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.14"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "acorn": "8.18.0",
    "esbuild": "0.21.5",
    "postcss-discard-comments": "^7.0.3",
    "protobufjs": "7.2.6",
    "protobufjs-cli": "1.1.3",
    "typescript": "^5.3.3",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.4.19",
    "vite-node": "3.2.4",
    "vite-plugin-md": "^0.21.5",
    "vite-plugin-monkey": "3.5.1",
    "vue-tsc": "^1.8.27",
    "wxt": "0.20.11"
  }
}
